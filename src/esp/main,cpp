#include <ESP32Servo.h>
#include <Stepper.h>

const int IN1 = 19;
const int IN2 = 18;
const int IN3 = 5;
const int IN4 = 17;
const int SERVO_PIN = 16;

const int PUMP_PIN = 22;
const int BUTTON_PIN = 23;
const int GREEN_LED = 21;
const int RED_LED = 25;

const int DOWN_ANGLE = 180; // tube down
const int TILT_ANGLE = 170; // tube tilt pos
const int RPM = 10;         // max 15
const int STEPS_PER_DEGREE = 20;

Stepper stepper(2048, IN1, IN3, IN2, IN4);
Servo servo;

void pour(int swings) {
  digitalWrite(PUMP_PIN, HIGH); // pump on

  for (int i = 0; i < swings; i++) {
    for (int a = DOWN_ANGLE; a >= TILT_ANGLE; a--) {
      servo.write(a);
      stepper.step(STEPS_PER_DEGREE);
    }
    for (int a = TILT_ANGLE; a <= DOWN_ANGLE; a++) {
      servo.write(a);
      stepper.step(STEPS_PER_DEGREE);
    }
  }

  digitalWrite(PUMP_PIN, LOW); // pump off
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, LOW);
  digitalWrite(IN4, LOW);
}

void brew() {
  pour(6);
  delay(15000); // 15s
  pour(12);
  delay(20000); // 20s
  pour(12);
}

void setup() {
  pinMode(PUMP_PIN, OUTPUT);
  digitalWrite(PUMP_PIN, LOW);
  pinMode(BUTTON_PIN, INPUT_PULLUP);

  pinMode(GREEN_LED, OUTPUT);
  pinMode(RED_LED, OUTPUT);
  digitalWrite(GREEN_LED, HIGH); // ready
  digitalWrite(RED_LED, LOW);

  stepper.setSpeed(RPM);
  servo.attach(SERVO_PIN);
  servo.write(DOWN_ANGLE);
}

void loop() {
  if (digitalRead(BUTTON_PIN) == LOW) {
    digitalWrite(GREEN_LED, LOW);
    digitalWrite(RED_LED, HIGH);

    brew();

    digitalWrite(RED_LED, LOW);
    digitalWrite(GREEN_LED, HIGH);

    while (digitalRead(BUTTON_PIN) == LOW) {
      delay(10);
    }
    delay(200);
  }
}